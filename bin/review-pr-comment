#!/bin/zsh
# Post Bitbucket PR comments ONLY after the author reviews a findings draft.
#
# Usage:
#   review-pr-comment <pr-id> <findings.md> [--publish]
#
# Default: posts with --pending (draft; not visible until you submit in Bitbucket UI).
# --publish: posts visible comments immediately (still requires author confirmation).
#
# findings.md format (one comment per block):
#
#   ### general
#   Overall summary markdown…
#
#   ### file:path/to/File.kt:42
#   Inline comment body…
#
#   ### file:path/to/Other.kt:10-15
#   Multi-line range uses start line as --to-line anchor…
#
set -euo pipefail

WORKFLOW_BIN="${0:A:h}"
export PATH="${WORKFLOW_BIN}:${PATH}"

if [[ $# -lt 2 ]]; then
  print "Usage: review-pr-comment <pr-id> <findings.md> [--publish]"
  exit 1
fi

PR_ID="$1"
FINDINGS="$2"
PENDING=1
[[ "${3:-}" == "--publish" ]] && PENDING=0

if [[ ! -f "$FINDINGS" ]]; then
  print "Missing findings file: $FINDINGS"
  exit 1
fi

if ! command -v bkt >/dev/null 2>&1; then
  print "bkt not found. Install: brew install bitbucket-cli"
  exit 1
fi

if bkt auth status 2>&1 | grep -qi 'No hosts configured'; then
  print "Bitbucket CLI not logged in."
  print "Run: bkt auth login https://bitbucket.org --kind cloud --web"
  exit 1
fi

print "═══ Author review required before any Bitbucket comments ═══"
print "PR:       #$PR_ID"
print "Findings: $FINDINGS"
print "Mode:     $([[ $PENDING -eq 1 ]] && echo 'PENDING (draft — you submit in Bitbucket UI)' || echo 'PUBLISH (visible immediately)')"
print ""
print "----- findings preview -----"
cat "$FINDINGS"
print "----- end preview -----"
print ""
print -n "Post these comments to Bitbucket PR #${PR_ID}? Type exactly YES to continue: "
read -r confirm
if [[ "$confirm" != "YES" ]]; then
  print "Aborted — no comments posted."
  exit 0
fi

# Parse ### headers into comment jobs
typeset -a kinds paths lines bodies
kinds=(); paths=(); lines=(); bodies=()
current_kind=""
current_path=""
current_line=""
current_body=""

flush() {
  [[ -z "$current_kind" ]] && return 0
  local trimmed
  trimmed="$(print -r -- "$current_body" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  [[ -z "$trimmed" ]] && return 0
  kinds+=("$current_kind")
  paths+=("$current_path")
  lines+=("$current_line")
  bodies+=("$trimmed")
}

while IFS= read -r line || [[ -n "$line" ]]; do
  if [[ "$line" == "### general" ]]; then
    flush
    current_kind="general"; current_path=""; current_line=""; current_body=""
  elif [[ "$line" == "### file:"* ]]; then
    flush
    local rest="${line#### file:}"
    current_kind="file"
    if [[ "$rest" == *:* ]]; then
      current_path="${rest%:*}"
      current_line="${rest##*:}"
      # range 10-15 → use start
      current_line="${current_line%%-*}"
    else
      current_path="$rest"
      current_line=""
    fi
    current_body=""
  else
    current_body+="${line}"$'\n'
  fi
done < "$FINDINGS"
flush

if (( ${#kinds} == 0 )); then
  print "No comment blocks found. Use ### general or ### file:path:line headers."
  exit 1
fi

print "Posting ${#kinds} comment(s)…"
integer i
for (( i=1; i <= ${#kinds}; i++ )); do
  local kind="${kinds[$i]}"
  local path="${paths[$i]}"
  local ln="${lines[$i]}"
  local body="${bodies[$i]}"
  local -a args
  args=(pr comment "$PR_ID" --text "$body")
  (( PENDING )) && args+=(--pending)
  if [[ "$kind" == "file" && -n "$path" && -n "$ln" ]]; then
    args+=(--file "$path" --to-line "$ln")
    print "  → inline $path:$ln $([[ $PENDING -eq 1 ]] && echo '[pending]')"
  else
    print "  → general $([[ $PENDING -eq 1 ]] && echo '[pending]')"
  fi
  bkt "${args[@]}"
done

print ""
print "Done."
if (( PENDING )); then
  print "Comments are PENDING drafts — open the PR in Bitbucket and submit the review when you are happy with them."
fi
